    {
      "id": "pD9-tqqSm4GDabpBsVWV7",
      "type": "text",
      "x": 1114.2384386796405,
      "y": 601.5044453690258,
      "width": 815.0394897460938,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
